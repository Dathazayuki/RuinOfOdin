{
  "name": "core-battle",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm run dev -w @core-battle/server\" \"npm run dev -w @core-battle/client\"",
    "build": "npm run typecheck && npm run build -w @core-battle/client && npm run build -w @core-battle/server",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "start": "npm run start -w @core-battle/server",
    "tunnel": "npx localtunnel --port 3001"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.4"
  }
}
